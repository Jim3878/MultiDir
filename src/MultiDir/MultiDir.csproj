<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- WinForms only for the tray icon (NotifyIcon); keep its namespaces out of the global usings. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Program.Main does the single-instance hand-off before WPF starts. -->
    <StartupObject>MultiDir.Program</StartupObject>
    <!-- App icon (drawn by tools/make-icon.ps1): exe / taskbar / Alt+Tab; also embedded for the window and tray. -->
    <ApplicationIcon>Assets\MultiDir.ico</ApplicationIcon>
    <!-- Test builds (tools/mdctl.ps1) use a separate artifacts path; never pick up the normal build's generated files. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\MultiDir.ico" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dirkster.AvalonDock" Version="4.74.1" />
    <PackageReference Include="Dirkster.AvalonDock.Themes.VS2013" Version="4.74.1" />
    <PackageReference Include="VirtualizingWrapPanel" Version="2.5.4" />
  </ItemGroup>

</Project>
