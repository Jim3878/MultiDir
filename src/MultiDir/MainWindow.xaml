<Window x:Class="MultiDir.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ad="https://github.com/Dirkster99/AvalonDock"
        xmlns:views="clr-namespace:MultiDir.Views"
        Title="MultiDir" Width="1400" Height="860" WindowStartupLocation="CenterScreen" Icon="Assets/MultiDir.ico"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}">
    <Window.InputBindings>
        <KeyBinding Key="T" Modifiers="Control" Command="{x:Static ApplicationCommands.New}"/>
        <KeyBinding Key="W" Modifiers="Control" Command="{x:Static ApplicationCommands.Close}"/>
        <KeyBinding Key="T" Modifiers="Control+Shift" Command="{x:Static ApplicationCommands.Undo}"/>
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static ApplicationCommands.New}" Executed="NewTab_Executed"/>
        <CommandBinding Command="{x:Static ApplicationCommands.Close}" Executed="CloseTab_Executed"/>
        <CommandBinding Command="{x:Static ApplicationCommands.Undo}" Executed="ReopenTab_Executed"/>
    </Window.CommandBindings>

    <DockPanel>
        <!-- Top bar: layout presets | Chrome-style bookmark bar | default-handler toggle. -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="6,3">
            <DockPanel LastChildFill="True">
                <Button x:Name="DefaultHandlerBtn" DockPanel.Dock="Right" Click="DefaultHandler_Click"
                        Style="{StaticResource CrumbButton}" Height="22" Padding="8,0" Margin="6,0,0,0"/>
                <!-- Copy / move queue: shown only while something is copying or waiting. -->
                <Button x:Name="QueueBtn" DockPanel.Dock="Right" Click="QueueBtn_Click" Visibility="Collapsed"
                        Style="{StaticResource CrumbButton}" Height="22" Padding="8,0" Margin="6,0,0,0"/>
                <!-- Presets are helpers only — dragging tabs is the primary way to split. -->
                <ToggleButton x:Name="SidebarBtn" DockPanel.Dock="Left" Style="{StaticResource ToolButton}" Content="&#xE700;"
                              ToolTip="側邊欄（書籤 / 樹狀目錄 / 歷史）" IsChecked="True" Click="SidebarBtn_Click" Margin="0,0,4,0"/>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"
                            ToolTip="拖曳分頁到窗格邊緣即可分割、拖到分頁列或功能列併入、拖出視窗變浮動">
                    <Button Style="{StaticResource ToolButton}" Content="&#xE739;" ToolTip="單格" Click="Preset_Click" Tag="1"/>
                    <Button Style="{StaticResource ToolButton}" Content="&#xE89F;" ToolTip="左右兩格" Click="Preset_Click" Tag="2"/>
                    <Button Style="{StaticResource ToolButton}" Content="&#xF0E2;" ToolTip="四宮格" Click="Preset_Click" Tag="4"/>
                    <Border Width="1" Background="{StaticResource Border}" Margin="6,3"/>
                </StackPanel>
                <views:BookmarkBar x:Name="Bookmarks" Height="26" OpenRequested="Bookmarks_OpenRequested"/>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="240" MinWidth="0"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <views:Sidebar x:Name="SidePanel" OpenRequested="Bookmarks_OpenRequested"/>
            <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="{StaticResource Surface}" ResizeBehavior="PreviousAndNext" Focusable="False"/>
        <Grid Grid.Column="2">
        <ad:DockingManager x:Name="Dock" AllowMixedOrientation="True"
                           DocumentClosed="Dock_DocumentClosed"
                           PreviewMouseDown="Dock_PreviewMouseDown"
                           ActiveContentChanged="Dock_ActiveContentChanged"
                           AllowDrop="True" DragEnter="Dock_DragOver" DragOver="Dock_DragOver"
                           DragLeave="Dock_DragLeave" Drop="Dock_Drop"/>
        <!-- Highlight of the pane header a floating window will join when released (see HeaderDocking). -->
        <Canvas IsHitTestVisible="False">
            <Border x:Name="HeaderDropHighlight" Visibility="Collapsed" CornerRadius="3"
                    Background="#553574F0" BorderBrush="{StaticResource Accent}" BorderThickness="2"/>
        </Canvas>
        </Grid>
        </Grid>
    </DockPanel>
</Window>
