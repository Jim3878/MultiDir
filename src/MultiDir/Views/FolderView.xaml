<UserControl x:Class="MultiDir.Views.FolderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             Background="{StaticResource Bg}">
    <UserControl.Resources>
        <!-- All three modes share one ListView and one item collection; switching only swaps these. -->
        <ItemsPanelTemplate x:Key="StackPanelTemplate">
            <VirtualizingStackPanel/>
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="WrapPanelTemplate">
            <vwp:VirtualizingWrapPanel SpacingMode="None" StretchItems="False"/>
        </ItemsPanelTemplate>

        <DataTemplate x:Key="LargeTemplate">
            <StackPanel Width="112" Margin="4,6">
                <Image Source="{Binding Thumbnail}" Width="96" Height="96" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="{Binding Name}" TextAlignment="Center" TextWrapping="Wrap" MaxHeight="34"
                           TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="SmallTemplate">
            <StackPanel Orientation="Horizontal" Width="220" Margin="4,2">
                <Image Source="{Binding SmallIcon}" Width="16" Height="16"/>
                <TextBlock Text="{Binding Name}" Margin="6,0,0,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>

        <GridView x:Key="DetailsView" x:Shared="False">
            <GridViewColumn Header="名稱" Width="300">
                <GridViewColumn.CellTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{Binding SmallIcon}" Width="16" Height="16"/>
                            <TextBlock Text="{Binding Name}" Margin="6,0,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="修改日期" Width="140" DisplayMemberBinding="{Binding ModifiedText}"/>
            <GridViewColumn Header="類型" Width="130" DisplayMemberBinding="{Binding TypeName}"/>
            <GridViewColumn Header="大小" Width="90" DisplayMemberBinding="{Binding SizeText}"/>
        </GridView>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar: ← → ↑ | breadcrumb | filter | view switch -->
        <Border x:Name="Toolbar" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="4,3">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Style="{StaticResource ToolButton}" Content="&#xE72B;" ToolTip="上一頁" Click="Back_Click" IsEnabled="{Binding CanGoBack}"/>
                    <Button Style="{StaticResource ToolButton}" Content="&#xE72A;" ToolTip="下一頁" Click="Forward_Click" IsEnabled="{Binding CanGoForward}"/>
                    <Button Style="{StaticResource ToolButton}" Content="&#xE74A;" ToolTip="上一層" Click="Up_Click" IsEnabled="{Binding CanGoUp}"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="6,0,0,0">
                    <ToggleButton x:Name="LargeBtn" Style="{StaticResource ToolButton}" Content="&#xE8B9;" ToolTip="大圖" Click="Mode_Click" Tag="Large"/>
                    <ToggleButton x:Name="ListBtn" Style="{StaticResource ToolButton}" Content="&#xE8FD;" ToolTip="列表" Click="Mode_Click" Tag="List"/>
                    <ToggleButton x:Name="SmallBtn" Style="{StaticResource ToolButton}" Content="&#xE80A;" ToolTip="小圖" Click="Mode_Click" Tag="Small"/>
                </StackPanel>
                <Grid DockPanel.Dock="Right" Width="130" Margin="6,0,0,0">
                    <TextBox x:Name="FilterBox" Style="{StaticResource FieldBox}" Height="24"
                             Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="FilterBox_PreviewKeyDown"/>
                    <TextBlock Text="&#xE71C; 篩選" Foreground="{StaticResource TextDim}" Margin="8,0" VerticalAlignment="Center"
                               FontFamily="Segoe UI, Segoe MDL2 Assets, Microsoft JhengHei" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Filter}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <!-- ☆ = add/remove this folder on the bookmark bar (like Chrome's star). -->
                <Button x:Name="StarBtn" DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Margin="2,0,0,0"
                        Content="&#xE734;" ToolTip="加入書籤" Click="Star_Click"/>
                <!-- Breadcrumb; clicking empty space turns it into an editable path box. -->
                <Border x:Name="CrumbHost" Background="{StaticResource Bg}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                        CornerRadius="3" Height="24" Margin="6,0,0,0" MouseLeftButtonDown="CrumbHost_MouseLeftButtonDown" Cursor="IBeam">
                    <Grid>
                        <ItemsControl x:Name="Crumbs" VerticalAlignment="Center" Cursor="Arrow" HorizontalAlignment="Left"
                                      AllowDrop="True" DragEnter="Crumbs_DragOver" DragOver="Crumbs_DragOver"
                                      DragLeave="Crumbs_DragLeave" Drop="Crumbs_Drop">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="›" Foreground="{StaticResource TextDim}" Margin="1,0" VerticalAlignment="Center"
                                                   Visibility="{Binding SeparatorVisibility}"/>
                                        <Button Style="{StaticResource CrumbButton}" Content="{Binding Label}" Tag="{Binding Path}"
                                                Click="Crumb_Click" Height="20"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBox x:Name="PathBox" Style="{StaticResource FieldBox}" BorderThickness="0" Visibility="Collapsed"
                                 KeyDown="PathBox_KeyDown" LostKeyboardFocus="PathBox_LostKeyboardFocus"/>
                    </Grid>
                </Border>
            </DockPanel>
        </Border>

        <ListView x:Name="List" Grid.Row="1" ItemsSource="{Binding View}"
                  Background="{StaticResource Bg}" Foreground="{StaticResource Text}" BorderThickness="0"
                  SelectionMode="Extended"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True"
                  MouseDoubleClick="List_MouseDoubleClick" PreviewMouseWheel="List_PreviewMouseWheel"
                  PreviewMouseDown="List_PreviewMouseDown" PreviewTextInput="List_PreviewTextInput"
                  PreviewKeyDown="List_PreviewKeyDown"
                  PreviewMouseLeftButtonDown="List_PreviewMouseButtonDown" PreviewMouseRightButtonDown="List_PreviewMouseButtonDown"
                  PreviewMouseMove="List_PreviewMouseMove" PreviewMouseUp="List_PreviewMouseUp"
                  AllowDrop="True" DragEnter="List_DragOver" DragOver="List_DragOver" DragLeave="List_DragLeave" Drop="List_Drop"/>

        <TextBlock Grid.Row="2" Text="{Binding Status}" Foreground="{StaticResource TextDim}" Margin="8,2" FontSize="11"/>
    </Grid>
</UserControl>
